{
  "name": "mrshkn-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.9.4",
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "node": "24.15.0",
    "yarn": "4.9.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "seed:lighthouse": "NODE_ENV=production payload run scripts/seed-lighthouse.ts",
    "test": "yarn typecheck && yarn lint && yarn test:unit && yarn test:integration && yarn test:e2e",
    "build:lighthouse": "SITE_ENV=production NEXT_DIST_DIR=.next-production NEXT_PUBLIC_SITE_URL=http://localhost:3102 next build"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "graphql": "^16.8.1",
    "next": "16.3.5",
    "next-intl": "4.14.5",
    "next-themes": "0.4.6",
    "nodemailer": "^10.0.10",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.5.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.5",
    "fontverter": "^2.0.0",
    "harfbuzzjs": "^0.10.3",
    "pg": "8.20.0",
    "prettier": "^3.6.0",
    "sass": "^1.93.0",
    "smtp-server": "^3.19.13",
    "subset-font": "^2.7.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yaml": "^1.10.3"
  }
}
