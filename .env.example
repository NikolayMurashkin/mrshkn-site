# Окружение сборки: preview | production.
# preview — превью Vercel, PR-сборки и закрытый стенд Coolify: каждая страница отдает noindex, nofollow.
# production — боевой mrshkn.com на Coolify.
# Значение по умолчанию, если переменная не задана, — preview.
SITE_ENV=preview

# Публичный адрес сборки без слеша на конце: используется в canonical и OG.
# Превью Vercel: https://<project>-<hash>.vercel.app, боевой: https://mrshkn.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Заявка с квиза уходит в три канала. Значения живут только в секретах хостинга
# (Vercel / Coolify), в репозитории — одни имена. Канал без своих переменных молчит:
# заявка все равно уходит в остальные, а отказ пишется в лог сервера.
# TELEGRAM_BOT_TOKEN   — токен бота заявок
# TELEGRAM_CHAT_IDS    — id чатов Николая и жены через запятую: бот пишет обоим
# TELEGRAM_API_URL     — база Telegram Bot API; пусто = https://api.telegram.org, в тестах — приемник
# BITRIX_WEBHOOK_URL   — входящий вебхук Bitrix24 без хвостового слеша, метод crm.lead.add
# SMTP_URL             — строка подключения для письма, например smtp://user:pass@smtp.yandex.ru:465
# LEAD_MAIL_TO         — куда падает письмо с заявкой (hello@mrshkn.com)
# LEAD_MAIL_FROM       — от кого уходит письмо; пусто = тот же адрес, что и получатель
#
# Появятся позже, вместе с Payload CMS:
# PAYLOAD_SECRET       — ключ подписи сессий Payload CMS
# DATABASE_URI         — строка подключения к Postgres в Coolify
