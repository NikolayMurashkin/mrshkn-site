# Окружение сборки: preview | production.
# preview — превью Vercel и PR-сборки: каждая страница отдает noindex, nofollow.
# production — боевой mrshkn.com (ставится в B45 на Coolify).
# Значение по умолчанию, если переменная не задана, — preview.
SITE_ENV=preview

# Публичный адрес сборки без слеша на конце: используется в canonical и OG.
# Превью Vercel: https://<project>-<hash>.vercel.app, боевой: https://mrshkn.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Секретов у сайта на этом этапе нет.
# Появятся позже и живут только в секретах хостинга (Vercel / Coolify), не в репозитории:
# PAYLOAD_SECRET       — B14, ключ подписи сессий Payload CMS
# DATABASE_URI         — B14, строка подключения к Postgres в Coolify
# TELEGRAM_BOT_TOKEN   — B4, токен бота заявок
# TELEGRAM_CHAT_IDS    — B4, id чатов Николая и жены через запятую
# BITRIX_WEBHOOK_URL   — B4, входящий вебхук Bitrix24
# SMTP_URL             — B12, отправка писем на hello@mrshkn.com
