# Окружение сборки: preview | production.
# preview — закрытый стенд Coolify и локальные сборки: каждая страница отдает noindex, nofollow.
# production — боевой mrshkn.com на Coolify.
# Значение по умолчанию, если переменная не задана, — preview.
SITE_ENV=preview

# Публичный адрес сборки без слеша на конце: используется в canonical и OG.
# Стенд: https://stage.mrshkn.com, боевой: https://mrshkn.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Заявка с квиза уходит в три канала: запись в базу сайта (заявки в админке), Telegram и почту.
# Базе хватает DATABASE_URI, ниже — переменные бота и почты. Значения живут только в секретах хостинга
# (Coolify), в репозитории — одни имена. Канал без своих переменных молчит:
# заявка все равно уходит в остальные, а отказ пишется в лог сервера.
# TELEGRAM_BOT_TOKEN   — токен бота заявок
# TELEGRAM_CHAT_IDS    — id чатов Николая и жены через запятую: бот пишет обоим
# TELEGRAM_API_URL     — база Telegram Bot API; пусто = https://api.telegram.org, в тестах — приемник
# SMTP_URL             — строка подключения для письма, например smtp://user:pass@smtp.yandex.ru:465
# LEAD_MAIL_TO         — куда падает письмо с заявкой (hello@mrshkn.com)
# LEAD_MAIL_FROM       — от кого уходит письмо; пусто = тот же адрес, что и получатель

# Счетчики. Читаются сервером на каждом запросе, не при сборке: ID ставятся переменными Coolify без пересборки
# образа. Нет ID — нет счетчика; загружаются только после «Принять» в cookie-баннере.
# METRIKA_ID — номер счетчика Яндекс Метрики (только цифры)
# GA4_ID     — идентификатор потока Google Analytics 4 (G-XXXXXXXXXX)
METRIKA_ID=
GA4_ID=

# Payload CMS. Локально база — Postgres из docker-compose.yml (`docker compose up -d`), на stage —
# `site-postgres` в Coolify. Сборке база не нужна, только работе.
DATABASE_URI=postgres://site:site@127.0.0.1:5434/site
# Ключ подписи сессий админки: локально любая строка, на сервере — своя длинная случайная (`openssl rand -hex 32`).
PAYLOAD_SECRET=
# Каталог медиатеки от корня репозитория, по умолчанию media; интеграционные тесты берут временный.
# MEDIA_DIR=media
# Только в образе (Dockerfile): при старте накатить миграции src/migrations/. Локально не задавать —
# базу разработки Payload ведет сам.
# MIGRATE_ON_START=true
